  "graphTooltip": 0,
  "links": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Device Status",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 10 },
      "datasource": { "type": "influxdb", "uid": "PA8DCAB329C51A876" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "PA8DCAB329C51A876" },
          "query": "from(bucket: \"hivis\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r._measurement == \"air_quality\")\n  |> filter(fn: (r) => r._field == \"iaq\" or r._field == \"co2\" or r._field == \"db\" or r._field == \"bat_pct\" or r._field == \"rssi\" or r._field == \"accuracy\")\n  |> last()\n  |> pivot(\n       rowKey: [\"_time\", \"device_id\", \"device_name\", \"group\"],\n       columnKey: [\"_field\"],\n       valueColumn: \"_value\"\n     )\n  |> keep(columns: [\"_time\", \"device_id\", \"device_name\", \"group\", \"iaq\", \"co2\", \"db\", \"bat_pct\", \"rssi\", \"accuracy\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "iaq" },
            "properties": [
              { "id": "displayName", "value": "IAQ" },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 100 },
                    { "color": "red", "value": 200 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "co2" },
            "properties": [
              { "id": "displayName", "value": "CO\u2082 (ppm)" },
              { "id": "unit", "value": "ppm" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "db" },
            "properties": [
              { "id": "displayName", "value": "Noise (dB)" },
              { "id": "unit", "value": "dB" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "bat_pct" },
            "properties": [
              { "id": "displayName", "value": "Battery %" },
              { "id": "unit", "value": "percent" },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "yellow", "value": 20 },
                    { "color": "green", "value": 50 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "rssi" },
            "properties": [
              { "id": "displayName", "value": "RSSI (dBm)" },
              { "id": "unit", "value": "dBm" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "accuracy" },
            "properties": [
              { "id": "displayName", "value": "Accuracy" },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "text": "Calibrating", "color": "red" },
                      "1": { "text": "Low", "color": "orange" },
                      "2": { "text": "Medium", "color": "yellow" },
                      "3": { "text": "Optimal", "color": "green" }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "_time" },
            "properties": [
              { "id": "displayName", "value": "Last Seen" },
              { "id": "unit", "value": "dateTimeFromNow" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "device_name" },
            "properties": [{ "id": "displayName", "value": "Device" }]
          },
          {
            "matcher": { "id": "byName", "options": "group" },
            "properties": [{ "id": "displayName", "value": "Group" }]
          },
          {
            "matcher": { "id": "byName", "options": "device_id" },
            "properties": [{ "id": "custom.hidden", "value": true }]
          }
        ]
      },
      "options": {
        "frameIndex": 0,
        "showHeader": true,
        "sortBy": [{ "displayName": "Last Seen", "desc": false }],
        "footer": { "show": false }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "IAQ Comparison — All Devices",
      "gridPos": { "x": 0, "y": 10, "w": 24, "h": 8 },
      "datasource": { "type": "influxdb", "uid": "PA8DCAB329C51A876" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "PA8DCAB329C51A876" },
          "query": "from(bucket: \"hivis\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"air_quality\")\n  |> filter(fn: (r) => r._field == \"iaq\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"mean\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5, "spanNulls": false, "showPoints": "auto" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 200 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Battery Overview — All Devices",
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 8 },
      "datasource": { "type": "influxdb", "uid": "PA8DCAB329C51A876" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "PA8DCAB329C51A876" },
          "query": "from(bucket: \"hivis\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r._measurement == \"air_quality\")\n  |> filter(fn: (r) => r._field == \"bat_pct\")\n  |> last()\n  |> group()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
