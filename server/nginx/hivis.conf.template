# ─────────────────────────────────────────────────────
#  PRODUCTION CONFIG  (Step 2: after SSL cert is issued)
#
#  HTTP  → redirects to HTTPS
#  HTTPS → serves the HIVIS dashboard
#          proxies /api/v2/query to InfluxDB (internal)
#
#  Requires cert at /etc/letsencrypt/live/hvht.net/
#
#  Environment variables (substituted at container start via envsubst):
#    INFLUX_TOKEN  — InfluxDB read-only token, injected server-side.
#                    Never sent to browsers.
# ─────────────────────────────────────────────────────

# ── HTTP: redirect + ACME renewal ──────────────────────
server {
    listen 80;
    server_name hvht.net www.hvht.net;

    # Let certbot renew automatically
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS: dashboard + InfluxDB proxy ──────────────────
server {
    listen 443 ssl;
    http2 on;
    server_name hvht.net www.hvht.net;

    # SSL certificate (issued by certbot)
    ssl_certificate     /etc/letsencrypt/live/hvht.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hvht.net/privkey.pem;

    # Modern SSL settings
    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;

    # Security headers
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    # Static dashboard
    root  /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # InfluxDB query proxy — injects the token server-side.
    # The browser sends no Authorization header; nginx adds it here.
    # INFLUX_TOKEN is provided as a container environment variable.
    location = /api/v2/query {
        proxy_pass         http://influxdb:8086/api/v2/query;
        proxy_http_version 1.1;
        proxy_set_header   Connection    "";
        proxy_set_header   Host          influxdb;
        proxy_set_header   Authorization "Token ${INFLUX_TOKEN}";

        proxy_connect_timeout  5s;
        proxy_read_timeout    30s;

        # Stream the CSV response without buffering (can be large)
        proxy_buffering off;
    }

    # Block everything else under /api to be safe
    location /api/ {
        return 403;
    }
}
